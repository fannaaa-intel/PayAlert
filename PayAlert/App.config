<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <connectionStrings>
    <!-- XAMPP default: user root with no password. Change Pwd if your MySQL root has one. -->
    <add name="PayAlertDb"
         connectionString="Server=localhost;Port=3306;Database=payalert_db;Uid=root;Pwd=;CharSet=utf8mb4;SslMode=Disabled;Connection Timeout=5;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
</configuration>
